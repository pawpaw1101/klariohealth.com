# Clario / Klario web app — local backend connection
# Copy to .env.local:  cp .env.example .env.local

# Backend API (Clario Backend at ../Biolens-Backend)
NEXT_PUBLIC_KLARIO_API_BASE_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_KLARIO_API_ROOT=http://127.0.0.1:8000

# Supabase server SDK
# Copy real values from the Supabase dashboard Connect dialog.
# Never commit SUPABASE_SECRET_KEY.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Production examples:
# NEXT_PUBLIC_KLARIO_API_BASE_URL=https://api.clario.com/api/v1
# NEXT_PUBLIC_KLARIO_API_ROOT=https://api.clario.com
